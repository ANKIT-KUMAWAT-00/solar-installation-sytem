# SUNPOWER SOLUTIONS — Environment Configuration Example

# Backend Configuration
PROJECT_NAME="SunPower Solutions ERP"
VERSION="1.0.0"
API_V1_STR="/api"

# Database (PostgreSQL / SQLite)
# For local dev without docker, defaults to SQLite: sqlite+aiosqlite:///./sunpower.db
DATABASE_URL="postgresql+asyncpg://sunpower_user:sunpower_secret_password@localhost:5432/sunpower_erp"
REDIS_URL="redis://localhost:6379/0"

# JWT Security
SECRET_KEY="sunpower_production_super_secret_jwt_key_2026_xyz"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
